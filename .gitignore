# The environment, not the design. 862 MB, almost all of it the OCCT kernel
# (OCP alone is 218 MB). One copy per machine, rebuilt from pyproject.toml.
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Derived output. Every file under out/ is regenerated by one check_all run,
# which takes about 12 seconds for a whole project, so none of it is worth
# keeping in history.
projects/*/out/
*.egg-info/

# The CLI's activity log: what ran and what it wrote. Runtime history the
# workbench reads, not design.
projects/.cad/
projects/*/.cad/

# The live viewer's current export, and what a CI verify writes into fixtures
tests/fixtures/*/out/
tests/fixtures/*/.cad/
tests/fixtures/*/checks.json
tests/fixtures/*/verify.json

# NOT ignored, deliberately:
#   projects/*/parts/*.py       the design itself
#   projects/*/assembly.py      how it goes together
#   projects/*/baseline/*.png   the approved renders. These are fixtures, not
#                               output: the visual gate has nothing to compare
#                               against without them, and they are ~10 KB each
#   projects/*/bought/          vendor geometry and its provenance sidecars
#   projects/*/checks.json      the record a report is rendered from
ui/node_modules/

# TypeScript's incremental build cache for ui/ (tsc -b).
*.tsbuildinfo

# What `cad eval run` scored: one JSON per run, kept by whoever ran it.
evals/results/

# What cad writes when it is pointed at a task's folders (its reference design): activity
# logs, renders, verdicts. Scoring drops them from the copy it grades anyway.
evals/**/.cad/
evals/**/out/
evals/**/checks.json
evals/**/verify.json
