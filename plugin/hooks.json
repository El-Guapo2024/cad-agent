{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/plugin/install.sh\"",
            "timeout": 900,
            "statusMessage": "cad-agent setup"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/cad_on_edit.py\"",
            "timeout": 300,
            "statusMessage": "cad check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/cad_on_stop.py\"",
            "timeout": 180,
            "statusMessage": "cad done"
          }
        ]
      }
    ]
  }
}
