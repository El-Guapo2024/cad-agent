{
  "permissions": {
    "allow": [
      "Bash(bin/cad *)",
      "Bash(./bin/cad *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cad_on_edit.py\"",
            "timeout": 300,
            "statusMessage": "cad check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cad_on_stop.py\"",
            "timeout": 180,
            "statusMessage": "cad done"
          }
        ]
      }
    ]
  }
}
