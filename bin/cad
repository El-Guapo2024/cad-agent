#!/bin/sh
# cad: run the cad-agent CLI with this checkout's own environment, from anywhere.
# Goes through the warm worker (cad_agent/warm.py) so the CAD kernel is imported
# once, not per call; CAD_WARM=0 runs cold. Follows symlinks, so linking this
# file onto your PATH works.
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
here="$(cd "$(dirname "$self")/.." && pwd -P)"
# The Python with cad-agent installed: CAD_PYTHON, else this checkout's .venv, else the one the
# Claude Code plugin's first-run hook made (plugin/install.sh), else python3.
py="${CAD_PYTHON:-}"
if [ -z "$py" ] && [ -x "$here/.venv/bin/python" ]; then py="$here/.venv/bin/python"; fi
if [ -z "$py" ] && [ -n "${CLAUDE_PLUGIN_DATA:-}" ] && [ -x "$CLAUDE_PLUGIN_DATA/venv/bin/python" ]; then py="$CLAUDE_PLUGIN_DATA/venv/bin/python"; fi
if [ -z "$py" ]; then
  for c in "$HOME"/.claude/plugins/data/cad-agent*/venv/bin/python; do
    if [ -x "$c" ]; then py="$c"; break; fi
  done
fi
exec "${py:-python3}" -m cad_agent.warm "$@"
